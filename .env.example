# API local; se enlaza únicamente a 127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173

# Opcional: ruta absoluta para mover la base de datos local.
# Por defecto se crea en ./data/vyralix.sqlite
# VYRALIX_DB_PATH=C:\Users\Usuario\AppData\Local\Vyralix\vyralix.sqlite

# Proveedores de texto (vacíos por defecto; los secretos solo viven aquí)
GEMINI_API_KEY=
GEMINI_MODEL=
# Generación de imágenes, independiente del modelo de texto; vacío/desactivado por defecto.
# Los modelos documentados incluyen gemini-nano-banana-2.1 y gemini-3.1-flash-lite-image.
# Cada generación puede consumir cuota o generar cargos según la cuenta de Google.
GEMINI_IMAGE_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Ollama debe escuchar solo en loopback; instala un modelo local y escribe aquí su id exacto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Prioridad para "Automático"; el orden se puede guardar desde Configuración
AI_PROVIDER_PRIORITY=gemini,groq,ollama

# Un fallback alojado puede tener costos según tu cuenta: apagado por defecto.
# Gemini/Groq solo serán elegibles como proveedores automáticos secundarios al activar su flag.
GEMINI_AUTO_FALLBACK=false
GROQ_AUTO_FALLBACK=false
AI_PROVIDER_TIMEOUT_MS=45000

# Media Studio: FFmpeg local opcional, nunca se descarga ni instala automáticamente.
# FFmpeg_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Máximo de carga por archivo (bytes); predeterminado 250 MiB, máximo 1 GiB.
# MEDIA_MAX_UPLOAD_BYTES=262144000
# Trabajos de renderizado simultáneos: 1 por defecto, máximo 2.
# MEDIA_MAX_CONCURRENT=1
# Tiempo máximo de cada renderizado (ms); predeterminado 30 minutos.
# MEDIA_RENDER_TIMEOUT_MS=1800000
# Margen posterior a cada WAV de narración por escena (segundos); predeterminado 0.5, rango 0-3.
# MEDIA_VOICE_SCENE_MARGIN_SECONDS=0.5
